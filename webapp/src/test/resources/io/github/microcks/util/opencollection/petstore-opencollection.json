{
  "opencollection": "1.0.0",
  "info": {
    "name": "Petstore API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "pet",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Find pets by status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pet/findByStatus?status=available"
          }
        },
        {
          "info": {
            "name": "Get pet by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pet/:petId"
          }
        }
      ]
    }
  ],
  "bundled": true
}
