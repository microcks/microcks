{
  "opencollection": "1.0.0",
  "info": {
    "name": "Démo API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalogue",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List catalogue items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{defaultHost}/api/v3/catalog/items",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query"
              },
              {
                "name": "size",
                "value": "20",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Get a catalogue item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{defaultHost}/api/v3/catalog/items/:id",
            "params": [
              {
                "name": "id",
                "value": "42",
                "type": "path"
              }
            ]
          }
        }
      ]
    },
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{defaultHost}/api/v3/orders"
          }
        },
        {
          "info": {
            "name": "Update an order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{defaultHost}/api/v3/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "7",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Delete an order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{defaultHost}/api/v3/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "7",
                "type": "path"
              }
            ]
          }
        }
      ]
    },
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{defaultHost}/api/v3/customers",
            "params": [
              {
                "name": "active",
                "value": "true",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "List customer addresses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{defaultHost}/api/v3/customers/:customerId/addresses",
            "params": [
              {
                "name": "customerId",
                "value": "3",
                "type": "path"
              }
            ]
          }
        }
      ]
    },
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{defaultHost}/api/v3/health"
          }
        }
      ]
    }
  ]
}
