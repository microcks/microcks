# Alternative distroless image based on Docker Hardened Images (DHI).
# Requires being logged in to the dhi.io registry (free with a Docker Hub account):
#   docker login dhi.io
#
# Multi-stage build:
#   1. extract - unpacks the Spring Boot fat jar for a faster classloading layout (dev image: shell + JDK)
#   2. train   - performs a JVM AOT cache (JEP 514) training run *inside the runtime image* so that the
#                cache is guaranteed to match the exact JVM used at runtime
#   3. final   - minimal distroless runtime: JRE + extracted application + AOT cache only

# ---- Stage 1: extract the Spring Boot fat jar ----
FROM dhi.io/eclipse-temurin:25-jdk-dev AS extract

WORKDIR /work
COPY target/*-exec.jar app.jar
RUN java -Djarmode=tools -jar app.jar extract --destination /work/application \
 && rm app.jar \
 && mkdir -p /work/lib /work/data /work/config

# The distroless runtime image ships libstdc++ but not libgcc_s, which the native protoc binary
# (extracted and executed at runtime by protoc-jar when importing Protobuf/gRPC artifacts) is
# dynamically linked against. Grab it from the dev image so it can be copied into the final stage.
RUN mkdir -p /work/native && cp -L /usr/lib/$(uname -m)-linux-gnu/libgcc_s.so.1 /work/native/

# ---- Stage 2: AOT training run inside the runtime image ----
# Exiting once the Spring context refresh completes produces a JVM AOT cache that dramatically
# reduces classloading/linking work at startup - the dominant boot cost on CPU-constrained
# containers. Lazy initialization is disabled during training to maximize the number of classes
# recorded in the cache. The RUN instruction uses the exec form as distroless images have no shell.
# OTEL_TRACES_EXPORTER is forced to 'none' because BuildKit injects OTEL_TRACES_EXPORTER=otlp and
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=unix:///dev/otel-grpc.sock into RUN steps when it propagates
# its own build trace (as docker/build-push-action does in CI). Spring Boot honours these standard
# variables and would then fail to start on the unsupported unix:// endpoint.
# AOT code caching (adapters and stubs) is disabled: that machine code is generated for the CPU
# features of the build machine (e.g. AVX-512 on Intel runners) and JDK 25 reloads it without any
# CPU feature check (see JDK-8377507 / JDK-8377630), crashing with SIGILL in ~AdapterBlob on CPUs
# lacking those features (e.g. AMD EPYC). Classes, heap objects and profiles - which carry the
# startup gain - remain in the cache.
FROM dhi.io/eclipse-temurin:25 AS train

USER 0
WORKDIR /deployments
COPY --from=extract /work/application /deployments/application
ENV SPRING_MAIN_LAZY_INITIALIZATION=false \
    OTEL_TRACES_EXPORTER=none
RUN ["java", "-XX:+UnlockDiagnosticVMOptions", "-XX:-AOTAdapterCaching", "-XX:-AOTStubCaching", \
     "-XX:AOTCacheOutput=/deployments/app.aot", "-Dspring.context.exit=onRefresh", \
     "-jar", "/deployments/application/app.jar"]

# ---- Stage 3: final distroless runtime image ----
FROM dhi.io/eclipse-temurin:25

# Some version information
LABEL maintainer="Laurent Broudoux <laurent@microcks.io>" \
      org.opencontainers.image.authors="Laurent Broudoux <laurent@microcks.io>" \
      org.opencontainers.image.title="Microcks Application" \
      org.opencontainers.image.description="Microcks is Open Source cloud-native native tool for API Mocking and Testing" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.documentation="https://github.com/microcks/microcks" \
      io.artifacthub.package.readme-url="https://raw.githubusercontent.com/microcks/microcks/master/README.md"

WORKDIR /deployments
COPY --from=extract --chown=65532:65532 /work/application /deployments/application
COPY --from=extract --chown=65532:65532 /work/lib /deployments/lib
COPY --from=extract --chown=65532:65532 /work/data /deployments/data
COPY --from=extract --chown=65532:65532 /work/config /deployments/config
COPY --from=train --chown=65532:65532 /deployments/app.aot /deployments/app.aot

# /usr/lib is part of the dynamic loader default search path, so no arch-specific dir is needed.
COPY --from=extract /work/native/libgcc_s.so.1 /usr/lib/libgcc_s.so.1

VOLUME /deployments/config
EXPOSE 8080

# There is no shell in this image so run-java.sh (and its JAVA_OPTIONS env variable) is not
# available anymore: use JAVA_TOOL_OPTIONS or JDK_JAVA_OPTIONS to pass extra JVM options.
# JDK_JAVA_OPTIONS is additive and picked up by the java launcher, so the AOT cache stays active
# even when deployments add their own options through JAVA_TOOL_OPTIONS.
ENV JDK_JAVA_OPTIONS="-XX:AOTCache=/deployments/app.aot -XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC"

# /deployments/lib/* remains on the classpath so that custom extension libraries can simply be
# mounted or copied there - no PropertiesLauncher/loader.path setting is needed.
USER 65532
ENTRYPOINT ["java", "-cp", "/deployments/application/app.jar:/deployments/lib/*", \
            "io.github.microcks.MicrocksApplication"]
