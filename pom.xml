<!--
  Microcks 2.0 study reactor. Independent from the 1.x reactor (pom.xml): new groupId (io.microcks),
  new Quarkus-based webapp and a Spring-free copy of the commons modules.
  Build with: mvn -f pom.xml verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.microcks</groupId>
  <artifactId>microcks-parent</artifactId>
  <packaging>pom</packaging>
  <version>2.0.0-SNAPSHOT</version>
  <modules>
    <module>commons/model</module>
    <module>commons/util-el</module>
    <module>commons/util</module>
    <module>artifacts/artifact-core</module>
    <module>artifacts/artifact-jsonschema</module>
    <module>artifacts/artifact-soap</module>
    <module>artifacts/artifact-metadata</module>
    <module>commons/test-core</module>
    <module>artifacts/artifact-openapi</module>
    <module>artifacts/artifact-asyncapi</module>
    <module>artifacts/artifact-graphql</module>
    <module>artifacts/artifact-grpc</module>
    <module>artifacts/artifact-soapui</module>
    <module>artifacts/artifact-postman</module>
    <module>artifacts/artifact-har</module>
    <module>artifacts/artifact-opencollection</module>
    <module>app</module>
    <module>minions/async</module>
    <module>distro</module>
  </modules>

  <name>Microcks 2.0 (study)</name>
  <description>Microcks: easy mocks for your microservices</description>
  <url>http://microcks.github.io</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <multi-project.rootdir>${project.basedir}</multi-project.rootdir>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
    <commons-io.version>2.22.0</commons-io.version>
    <hazelcast.version>5.7.0</hazelcast.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.39.0</version>
        <configuration>
          <!-- define Java language-specific format -->
          <java>
            <toggleOffOn />
            <eclipse>
              <file>${multi-project.rootdir}/eclipse-formatter.xml</file>
            </eclipse>
            <indent>
              <spaces>true</spaces>
              <spacesPerTab>3</spacesPerTab>
            </indent>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>compile</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
