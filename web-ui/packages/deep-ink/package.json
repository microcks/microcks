{
  "name": "@microcks/deep-ink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Deep Ink for Svelte 5: design tokens (CSS + Tailwind theme + JSON) and components built on the Deep Ink CSS class API.",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
