    "./styles.css": "./src/styles/deep-ink.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./tokens.json": "./src/styles/tokens.json",
    "./assets/microcks-logo.svg": "./src/assets/microcks-logo.svg"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "sync-styles": "node scripts/sync-styles.mjs"
  },
